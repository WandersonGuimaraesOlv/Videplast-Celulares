# Modelo do .env (o compartilhamento da rede bloqueia arquivos .env*, por isso o nome).
# No servidor: cp env.exemplo .env && chmod 600 .env e preencha. O .env nunca vai para o GitHub.
CELULARES_PORTA=8097
VITE_BASE_PATH=celulares
# Supabase do Imobilizados ("Videplast Rio Verde Project"); a chave é a secret (sb_secret_...)
SUPABASE_URL=
SUPABASE_KEY=
BUCKET_FOTOS=celulares-fotos
# Filial dos chips (contrato TIM de Rio Verde) e da lista de centros de custo
FILIAL=1005
LIMITE_UPLOAD_MB=20
